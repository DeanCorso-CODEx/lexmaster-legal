  "rules": [
    { "text": "Taxa se plătește anticipat, dacă legea nu prevede altfel.", "cite": "art. 33 alin. (1)", "ref": "OUG80_2013:art_33" },
    { "text": "Cererile cu mai multe capete, cu obiecte diferite, se taxează separat pentru fiecare capăt, după natura lui.", "cite": "art. 34 alin. (1)", "ref": "OUG80_2013:art_34" },
    { "text": "Dacă suma cerută se reduce după înregistrare, taxa rămâne calculată la valoarea inițială.", "cite": "art. 37", "ref": "OUG80_2013:art_37" },
    { "text": "Împotriva modului de stabilire a taxei se poate cere reexaminarea, în 3 zile de la comunicarea taxei; cererea e scutită de taxă.", "cite": "art. 39 alin. (1)", "ref": "OUG80_2013:art_39" },
    { "text": "Persoanele fizice pot primi scutiri, reduceri, eșalonări sau amânări prin ajutorul public judiciar (OUG nr. 51/2008).", "cite": "art. 42 alin. (1)", "ref": "OUG80_2013:art_42" },
    { "text": "Restituirea taxei se cere în cel mult un an de la data nașterii dreptului la restituire.", "cite": "art. 45 alin. (3)", "ref": "OUG80_2013:art_45" }
  ],
  "exemptAppealNote": "Scutirea privește și căile de atac, ordinare și extraordinare (art. 29 alin. (1) partea introductivă)."
